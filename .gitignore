# Node / pnpm / moon
node_modules/
.pnpm-store/
dist/
.next/
out/
*.tsbuildinfo

# moon (ADR-0014) — cache is machine-local and not portable; the docker/
# workspace and docker/sources skeletons are generated by `moon docker
# scaffold` at build time, never committed.
.moon/cache/
.moon/docker/

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env files — never commit real secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code local config — never commit
.claude/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker
*.pid

# apps/web's service worker is now built via @serwist/turbopack's Route
# Handler (app/serwist/[path]/route.ts) instead of a webpack plugin that
# wrote public/sw.js — nothing is generated into the repo tree to ignore
# here anymore; output lives under the already-ignored .next/.

# SBOM outputs (syft)
.sbom-out/

# Terraform (ADR-0016) — state and plan files can contain resource
# metadata (bootstrap/'s local state) or, worse, secret values baked in
# by a provider's own schema (see infra/terraform/modules/upstash's
# known-limitation doc comment) — never commit any of these, remote
# state in GCS is the source of truth.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/plan.out
infra/terraform/**/plan.json
infra/terraform/**/*.tfplan
infra/terraform/**/.token
infra/terraform/**/.envrc
.vercel
.env*

# Advocate legal-review drafts — sensitive, delivered privately, never commit to the public repo
docs/legal/advocate-review/
