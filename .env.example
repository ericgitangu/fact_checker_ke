# Copy to .env and fill in local values. Never commit real secrets (see .gitignore).

# --- services/api ---
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@localhost:5432/fact_checker_ke

# --- services/pipeline ---
PIPELINE_PORT=8000

# --- LLM / inference (no real keys in dev -- pipeline uses fakes only) ---
ANTHROPIC_API_KEY=sk-ant-placeholder

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder-token

# --- QStash (event delivery, see docs/adr/0009-runtime-topology.md) ---
QSTASH_TOKEN=placeholder-token
QSTASH_CURRENT_SIGNING_KEY=placeholder
QSTASH_NEXT_SIGNING_KEY=placeholder

# --- GCS (transient audio blobs, 24h lifecycle) ---
GCS_BUCKET=placeholder-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/placeholder.json

# --- Billing / monetization (ADR-0012; all fail-closed when unset) ---
# Paystack (lead PSP): webhook HMAC-SHA512 secret.
PAYSTACK_SECRET_KEY=paystack-secret-placeholder
# apps/web origin, used to build the PSP checkout callback URL.
WEB_BASE_URL=http://localhost:3000
# M-Pesa (Safaricom Daraja C2B STK push). MPESA_ENV stays `sandbox` until go-live.
MPESA_ENV=sandbox
MPESA_C2B_CONSUMER_KEY=placeholder
MPESA_C2B_CONSUMER_SECRET=placeholder
MPESA_C2B_SHORTCODE=174379
MPESA_C2B_ONLINE_PASSKEY=placeholder
MPESA_C2B_CALLBACK_URL=https://api.example.test/v1/billing/webhook/mpesa
# Comma-separated Safaricom callback source IPs/CIDRs; UNSET => every callback rejected.
MPESA_CALLBACK_IP_ALLOWLIST=
# Premium price in whole KES (the STK push amount); unset => adapter default (1 KES, sandbox-safe).
MPESA_C2B_AMOUNT=200
# Stripe (global card fallback). STRIPE_PRICE_ID must be a ONE-TIME price (one-off Premium pass).
STRIPE_SECRET_KEY=stripe-secret-placeholder
STRIPE_WEBHOOK_SECRET=stripe-webhook-secret-placeholder
STRIPE_PRICE_ID=price_placeholder

# --- apps/web AdSense (ADR-0012 §4; ads inert until set) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=

# apps/site (Vite) — marketing waitlist
VITE_API_URL=http://localhost:8080
VITE_WEB_URL=http://localhost:3000
